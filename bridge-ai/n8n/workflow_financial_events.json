        0,
        300
      ],
      "webhookId": "38d35750-0e89-4fa3-941e-da86bbb4c54f"
    },
    {
      "parameters": {
        "jsCode": "// Bridge AI — validate and normalise an incoming financial event.\n// BACKEND_URL is not a secret. Change it to where your FastAPI backend runs:\n//   n8n in Docker + backend on your laptop -> http://host.docker.internal:8000\n//   n8n installed with npm on the same machine -> http://localhost:8000\nconst BACKEND_URL = 'http://host.docker.internal:8000';\n\nconst ALLOWED = {\n  shift_cancelled: ['shift_id'],\n  bill_updated: ['bill_id', 'new_amount_minor'],\n  income_delayed: ['new_date'],\n  new_bill: ['amount_minor', 'due_date'],\n  shift_added: ['amount_minor', 'due_date'],\n};\nconst MINOR_FIELDS = ['amount_minor', 'old_amount_minor', 'new_amount_minor'];\n\nconst raw = $input.first().json.body ?? {};\nconst errors = [];\nfor (const f of ['event_id', 'user_id', 'event_type', 'source']) {\n  if (typeof raw[f] !== 'string' || raw[f].trim() === '') errors.push(`missing ${f}`);\n}\nif (raw.event_type && !ALLOWED[raw.event_type]) errors.push(`unsupported event_type ${raw.event_type}`);\nfor (const f of ALLOWED[raw.event_type] ?? []) if (raw[f] === undefined || raw[f] === null) errors.push(`missing ${f}`);\nfor (const f of MINOR_FIELDS) {\n  if (raw[f] !== undefined && !(Number.isInteger(raw[f]) && raw[f] >= 0)) errors.push(`${f} must be a non-negative integer (pence)`);\n}\nif ((raw.currency ?? 'GBP') !== 'GBP') errors.push('only GBP is supported');\n\n// Transform to Bridge's internal format: only known fields are forwarded.\nconst KEEP = ['event_id','user_id','event_type','currency','source','event_date','shift_id','bill_id',\n  'amount_minor','old_amount_minor','new_amount_minor','due_date','new_date','label'];\nconst event = Object.fromEntries(KEEP.filter((k) => raw[k] !== undefined).map((k) => [k, raw[k]]));\nevent.currency = event.currency ?? 'GBP';\n\nreturn [{ json: { valid: errors.length === 0, errors, event, backend_url: BACKEND_URL,\n  received_at: new Date().toISOString() } }];\n"
      },
      "id": "d83b6817-54dd-4098-aac9-016c7ee46a1e",
      "name": "Validate & transform",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
