# ---------------------------------------------------------------
# Bridge AI configuration. Copy to .env and fill in what you need.
# The app boots in demo mode with NONE of these set.
# Never commit .env — it is in .gitignore.
# ---------------------------------------------------------------

# Demo mode: fictional user, demo controls enabled, demo secret allowed.
DEMO_MODE=true

# SQLite file for the backend (relative to the backend/ folder).
DATABASE_URL=sqlite:///./bridge.db

# Allowed browser origin(s) for CORS, comma separated.
FRONTEND_ORIGIN=http://localhost:5173

# --- n8n (required for the "via n8n" path; otherwise demo buttons use a labelled local simulation)
# Production webhook URL of the "Bridge AI — Financial shock detection" workflow.
# Test URL looks like .../webhook-test/bridge-financial-events, production like .../webhook/bridge-financial-events
N8N_WEBHOOK_URL=
# Shared secret sent as the X-Bridge-Secret header in BOTH directions (n8n <-> backend).
# Must match the "Bridge shared secret" Header Auth credential in n8n.
# If empty and DEMO_MODE=true, the backend uses the documented demo value "bridge-demo-secret".
N8N_SHARED_SECRET=
# Where n8n can reach the backend (documentation only — set it in the n8n Config nodes).
BACKEND_INTERNAL_URL=http://host.docker.internal:8000

# --- ElevenLabs (server-side only; never put these in the frontend)
# Needed for spoken briefings (TTS) AND live conversation.
ELEVENLABS_API_KEY=
# Needed for spoken briefings (TTS).
ELEVENLABS_VOICE_ID=
# Optional — defaults to eleven_multilingual_v2.
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# Needed for the live Penny conversation (agent with Bridge client tools, see docs/elevenlabs-agent-setup.md).
ELEVENLABS_AGENT_ID=

# --- Optional LLM: not used by this build. All explanations use deterministic templates.
LLM_API_KEY=
